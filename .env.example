POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_HOST_PORT=5433
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

OLLAMA_BASE_URL=http://ollama:11434
EMBEDDING_MODEL=qwen3-embedding:0.6b
CHUNK_MAX_LINES=40
MAX_FILE_BYTES=1000000
MAX_QUERY_CHARS=8000
MAX_RERANK_CANDIDATES=64
RERANKER_RRF_WEIGHT=0.3
RERANKER_EXACT_RRF_WEIGHT=0.95
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
RERANKER_DEVICE=auto
RERANKER_INSTRUCTION=Given a software repository search query, retrieve source code or technical documentation that directly matches the requested symbol, file, endpoint, behavior, date, or requirement
MAX_SEQUENCE_LENGTH=256
MAX_DOCUMENT_CHARS=4000
RERANKER_BATCH_SIZE=8
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

DENSE_INDEX_URL=http://dense-index-cpp:8081
DENSE_SEARCH_MODE=hnsw
HNSW_M=16
HNSW_EF_CONSTRUCTION=200
HNSW_EF_SEARCH=100
LEXICAL_INDEX_URL=http://lexical-index-java:8082
RERANKER_URL=http://reranker-python:8083
HEALTH_TIMEOUT_SECONDS=3
OLLAMA_HEALTH_TIMEOUT_SECONDS=5
EMBEDDING_TIMEOUT_SECONDS=30
INDEX_TIMEOUT_SECONDS=120
SEARCH_TIMEOUT_SECONDS=10
RERANKER_TIMEOUT_SECONDS=45
HTTP_RETRY_COUNT=1
CIRCUIT_BREAKER_FAILURES=3
CIRCUIT_BREAKER_RESET_SECONDS=15

ORCHESTRATOR_PORT=8080
ORCHESTRATOR_HOST_PORT=8090
DENSE_INDEX_PORT=8081
LEXICAL_INDEX_PORT=8082
RERANKER_PORT=8083
